{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "environment": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "cluster": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["production", "staging", "development"]
        }
      }
    }
  }
}
